# Database
POSTGRES_DB=worker
POSTGRES_USER=worker
POSTGRES_PASSWORD=dev

# Messaging (set Messaging__Enabled=true to activate Kafka publishing)
Messaging__Enabled=false
Messaging__Kafka__BootstrapServers=localhost:9092
Messaging__Kafka__Topic=worker-logs

# S3 (use LocalStack for local development)
S3__BucketName=onlyspans-snapshots
S3__Region=us-east-1
S3__Endpoint=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# gRPC endpoints (override for local multi-service development)
TargetsController__Endpoint=http://localhost:5001
Processes__Endpoint=http://localhost:5002
